{
  "id": "minimal",
  "name": "Minimal",
  "note": "Land and water only with very light borders, for overlays and lower thirds.",
  "ocean": "#ffffff",
  "land": {
    "fill": "#e9e9e9",
    "palette": null,
    "highlight": "#2b6cb0",
    "fade": "#f3f3f3"
  },
  "lakes": {
    "fill": "#ffffff",
    "stroke": "none",
    "width": 0
  },
  "rivers": {
    "stroke": "#ffffff",
    "width": 0,
    "show": false
  },
  "coastline": {
    "stroke": "#cfcfcf",
    "width": 1
  },
  "borders": {
    "stroke": "#ffffff",
    "width": 1.6
  },
  "provinceLines": {
    "stroke": "#ffffff",
    "width": 0.8,
    "show": false
  },
  "graticule": {
    "stroke": "#000000",
    "width": 0,
    "show": false
  },
  "places": {
    "fill": "#444444",
    "stroke": "#ffffff",
    "radius": 4,
    "capitalShape": "circle"
  },
  "labels": {
    "font": "'Inter', 'Helvetica Neue', Arial, sans-serif",
    "fill": "#555555",
    "halo": "#ffffff",
    "haloWidth": 3,
    "countrySize": 22,
    "countryWeight": 500,
    "countryCase": "none",
    "letterSpacing": 0.5,
    "placeSize": 18,
    "placeWeight": 500
  },
  "effects": {},
  "city": {
    "land": "#efefef",
    "parks": "#e5e5e5",
    "buildings": "#e3e3e3",
    "waterwayWidth": 2,
    "roads": {
      "minor": {
        "stroke": "#ffffff",
        "width": 2
      },
      "medium": {
        "stroke": "#ffffff",
        "width": 3.5
      },
      "major": {
        "stroke": "#ffffff",
        "width": 5
      }
    },
    "rail": {
      "stroke": "#cfcfcf",
      "width": 1.5,
      "dash": "6 4"
    },
    "ferry": null,
    "streetLabelSize": 13,
    "streetLabelWeight": 500,
    "streetLabelLimit": 80,
    "areaLabelSize": 18
  }
